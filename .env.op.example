# Copy to .env.op (git-ignored). Use 1Password references (op://...), never secret values.
EBOEKHOUDEN_API_TOKEN="op://<vault>/<item>/credential"
# Expiry date of the token, used to warn 30 days in advance (optional).
EBOEKHOUDEN_API_TOKEN_EXPIRES="op://<vault>/<item>/expires"
# Optional: integration identifier sent to e-Boekhouden (1-10 letters, digits, _ or space).
# EBOEKHOUDEN_SOURCE="mcp_eb"
# Optional: absolute path for the audit log (default: logs/audit.jsonl in the install).
# EBOEKHOUDEN_AUDIT_LOG="/absolute/path/to/audit.jsonl"
