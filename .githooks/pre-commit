#!/usr/bin/env sh
# Blocks commits that contain secrets. Enabled via `npm install` (prepare script).
set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); commit blocked." >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
