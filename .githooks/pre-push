#!/usr/bin/env sh
# Blocks direct pushes to main; changes go through a pull request.
# (Server-side branch protection needs GitHub Pro for private repositories.)
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is blocked; open a pull request instead." >&2
    exit 1
  fi
done
exit 0
